{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet user-secrets:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(stripe listen:*)",
      "Bash(stripe trigger:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet run:*)",
      "PowerShell(dotnet new:*)",
      "PowerShell(dotnet add:*)",
      "PowerShell(dotnet sln:*)",
      "PowerShell(dotnet user-secrets:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git status:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git checkout:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr create:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh label:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr close:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue delete:*)",
      "PowerShell(gh label:*)",
      "PowerShell(gh release:*)",
      "PowerShell(gh workflow run:*)",
      "PowerShell(gh api:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/spec-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/harness-guard.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-gate.mjs"
          }
        ]
      }
    ]
  }
}
