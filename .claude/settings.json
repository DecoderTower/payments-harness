{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet user-secrets:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(stripe listen:*)",
      "Bash(stripe trigger:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet run:*)",
      "PowerShell(dotnet new:*)",
      "PowerShell(dotnet add:*)",
      "PowerShell(dotnet sln:*)",
      "PowerShell(dotnet user-secrets:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git status:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git checkout:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr create:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project view:*)",
      "Bash(gh project list:*)",
      "Bash(gh project field-list:*)",
      "PowerShell(gh project item-list:*)",
      "PowerShell(gh project view:*)",
      "PowerShell(gh project list:*)",
      "PowerShell(gh project field-list:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh label:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr close:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue delete:*)",
      "PowerShell(gh label:*)",
      "PowerShell(gh release:*)",
      "PowerShell(gh workflow run:*)",
      "PowerShell(gh api:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh project item-add:*)",
      "Bash(gh project item-archive:*)",
      "Bash(gh project item-delete:*)",
      "Bash(gh project item-create:*)",
      "Bash(gh project field-create:*)",
      "Bash(gh project field-delete:*)",
      "Bash(gh project edit:*)",
      "Bash(gh project delete:*)",
      "Bash(gh project close:*)",
      "Bash(gh project copy:*)",
      "Bash(gh project link:*)",
      "Bash(gh project unlink:*)",
      "Bash(gh project create:*)",
      "Bash(gh project mark-template:*)",
      "PowerShell(gh project item-edit:*)",
      "PowerShell(gh project item-add:*)",
      "PowerShell(gh project item-archive:*)",
      "PowerShell(gh project item-delete:*)",
      "PowerShell(gh project item-create:*)",
      "PowerShell(gh project field-create:*)",
      "PowerShell(gh project field-delete:*)",
      "PowerShell(gh project edit:*)",
      "PowerShell(gh project delete:*)",
      "PowerShell(gh project close:*)",
      "PowerShell(gh project copy:*)",
      "PowerShell(gh project link:*)",
      "PowerShell(gh project unlink:*)",
      "PowerShell(gh project create:*)",
      "PowerShell(gh project mark-template:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/spec-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/harness-guard.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-gate.mjs"
          }
        ]
      }
    ]
  }
}
